# MariaDB (Docker) - used by docker-compose.yml
MARIADB_ROOT_PASSWORD="root_dev_password"
MARIADB_DATABASE="munay"
MARIADB_USER="munay"
MARIADB_PASSWORD="munay_dev_password"

# MySQL-compatible connection string (required for Prisma, see backend/.env)
DATABASE_URL="mysql://munay:munay_dev_password@localhost:3306/munay"

# API
PORT=3001

# Frontend (Vite)
VITE_API_URL="http://localhost:3001"
